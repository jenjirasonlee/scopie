# Scopie environment variables. Copy to .env.local and fill in.
# Never commit real values. Only NEXT_PUBLIC_* variables are sent to the browser.

# --- Supabase (required) ---
# Local: printed by `pnpm db:start` (API URL and anon key).
# Hosted: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this app, used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# Used by the Meta OAuth callback/disconnect (to store and delete encrypted tokens),
# the sync worker, scripts/seed-demo.ts and the tests. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts platform access tokens at rest. 32 random bytes, base64:
#   openssl rand -base64 32
# Keep it safe: if it is lost, every platform must be reconnected.
SCOPIE_ENCRYPTION_KEY=

# --- Meta connector (Instagram + Facebook). Leave empty to run without it. ---
# See docs/API_INTEGRATIONS.md, "Setting up the Meta connector".
META_APP_ID=
META_APP_SECRET=
# Optional: Graph API version, e.g. v24.0. Defaults to the version pinned in code.
META_GRAPH_API_VERSION=

# Public YouTube channels (Phase 4). A YouTube Data API v3 key from Google Cloud Console.
# Server only: never prefix with NEXT_PUBLIC_. Restrict it to the YouTube Data API.
YOUTUBE_API_KEY=

# Public X profiles (Phase 10). An X API v2 app-only Bearer token from developer.x.com
# (project → app → Keys and tokens). X bills pay-per-use credits per item read; buy them in
# the developer portal. Server only: never prefix with NEXT_PUBLIC_, never paste it in chat
# or commit it. Set it in Trigger.dev too if the sync runs there. Bluesky needs no key.
X_BEARER_TOKEN=

# AI analyst (Phase 8). Optional: without a key, Scopie's own rules write the insights from
# the numbers. With one, an OpenAI model rewords them and Scopie checks every number before
# saving. Server only: never prefix with NEXT_PUBLIC_, never paste the key in chat or commit it.
OPENAI_API_KEY=
# The model that words insights (default gpt-4.1-mini).
AI_MODEL_INSIGHTS=
# Analyses per organization per day that may call the model (default 20).
AI_MAX_RUNS_PER_DAY=

# Weekly reports (Phase 9). The hourly schedule (trigger/reports.ts) asks the app to make
# the reports that are due by calling /api/reports/weekly with this secret. Set the same
# value in the app and in the Trigger.dev project, plus SCOPIE_APP_URL there. Generate one
# with: openssl rand -base64 48
REPORTS_CRON_SECRET=

# Content files (Phase 5). "supabase" keeps them in a private Supabase Storage bucket
# (created automatically; needs SUPABASE_SERVICE_ROLE_KEY). "local" keeps them in a folder
# on this server, for development. Left empty: Supabase when the service role key is set.
ASSET_STORAGE=
ASSET_LOCAL_DIR=

# --- Trigger.dev (scheduled sync). Optional: `pnpm sync:worker --watch` works without it. ---
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Password for the demo user created by `pnpm db:seed` (local development only).
DEMO_USER_PASSWORD=scopie-demo-password
